{
  "name": "tomate",
  "private": true,
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "dev": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "build": "expo export --platform all",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "doctor": "npx expo-doctor",
    "build:ios": "npx eas-cli build --platform ios --profile production",
    "submit:ios": "npx eas-cli submit --platform ios --profile production",
    "assets:generate": "node scripts/generate-assets.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/anton": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/metro-runtime": "~57.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "expo": "~57.0.21",
    "expo-camera": "~57.0.4",
    "expo-dev-client": "~57.0.18",
    "expo-font": "~57.0.3",
    "expo-image-manipulator": "~57.0.16",
    "expo-linear-gradient": "~57.0.1",
    "expo-location": "~57.0.16",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "~19.2.2",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  }
}
