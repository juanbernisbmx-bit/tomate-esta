# Público en el bundle: nunca poner secretos aquí.
# Vacío = demo local, sin IA ni sincronización real.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_UBER_CLIENT_ID=

# Identificador definitivo de tu organización, antes del primer build firmado.
# Sin configurar se usa app.tomate.mobile para desarrollo.
APP_BUNDLE_IDENTIFIER=
# Se obtiene ejecutando eas init con la cuenta del equipo.
EAS_PROJECT_ID=
